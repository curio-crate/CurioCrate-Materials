{
  "name": "curiocrate-materials",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.mts",
    "db:seed": "tsx --conditions=react-server scripts/seed.mts",
    "media:generate": "tsx scripts/generate-media.mts",
    "media:upload": "tsx scripts/upload-media.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@electric-sql/pglite": "^0.5.13",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.2",
    "hls.js": "^1.7.4",
    "jose": "^6.2.14",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "postgres": "^4.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
