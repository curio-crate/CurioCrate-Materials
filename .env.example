# Curiocrate Materials: environment variables
# Copy to .env.local for development. Every service falls back to a test mode or local stand-in
# when its keys are missing, so the app and all tests run with this file empty.
# Never commit real keys.

# ---------- Core ----------
# Public URL of the site (used for OAuth callbacks, QR codes, share links)
APP_URL=https://materials.curiocrate.org
# 32+ random characters. Signs file/video links and student sessions. REQUIRED in production.
SESSION_SECRET=
# 1 = refuse the embedded database and local disk even outside Vercel production (production always refuses them)
REQUIRE_CLOUD=
# Bearer token Vercel Cron sends to /api/cron/* (retention cleanup, subscription expiry)
CRON_SECRET=

# ---------- Company (Curiocrate Studio) login at /company/login ----------
# Username + password only (teacher Google accounts never open Studio). Accounts live in the database; add more
# in Studio → Team. The FIRST account is created from these on first sign-in. REQUIRED on a deployed site: the
# development account (CurioCrateAdmin) is only created on a developer's computer and in tests.
# ADMIN_PASSWORD_HASH format: scrypt:<saltHex>:<hashHex> (64-byte key), instead of ADMIN_PASSWORD.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Account recovery: 1 resets ADMIN_USERNAME's password to ADMIN_PASSWORD on the next sign-in. Remove afterwards.
ADMIN_PASSWORD_RESET=

# ---------- Database (PostgreSQL) ----------
# Unset = embedded PostgreSQL (PGlite) in .data/pglite (development only). REQUIRED in production: Neon URL.
DATABASE_URL=
DATABASE_POOL_MAX=5
# Optional: where PGlite keeps its files when DATABASE_URL is unset
PGLITE_DIR=

# ---------- Sign-in ----------
# Google OAuth client (console.cloud.google.com → Credentials). Redirect URI: {APP_URL}/api/auth/google/callback
# REQUIRED on a deployed site. Unset on a developer's computer = local test identity provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clever (Phase 2). Redirect URI: {APP_URL}/api/auth/clever/callback
CLEVER_CLIENT_ID=
CLEVER_CLIENT_SECRET=
# ClassLink (Phase 2). Redirect URI: {APP_URL}/api/auth/classlink/callback
CLASSLINK_CLIENT_ID=
CLASSLINK_CLIENT_SECRET=

# ---------- Video (Mux) ----------
# Signed playback: create a signing key in Mux → Settings → Signing keys. Private key is base64 PEM as Mux gives it.
# Unset = local HLS stand-in served from .media/ with signed, short-lived URLs.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
# API token for scripts/upload-media.ts (uploads videos + captions, enables low-res MP4 downloads)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Lifetime of signed playback links (seconds)
VIDEO_TOKEN_TTL_SEC=600

# ---------- File storage (S3-compatible, e.g. Cloudflare R2) ----------
# Handouts, manuals, JavaScript lessons and (without Mux) videos. Studio uploads go straight from the browser to the
# bucket, so the bucket needs a CORS rule allowing PUT from APP_URL (docs/deployment.md).
# REQUIRED in production. Unset on a developer's computer = local disk (.media/) with signed URLs.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Lifetime of presigned download links (seconds)
FILE_URL_TTL_SEC=300

# ---------- Payments (Stripe) ----------
# Use sk_test_... until launch. Unset = local checkout stand-in that sends Stripe-format test events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (Phase 3 subscriptions)
STRIPE_PRICE_TEACHER_YEARLY=
STRIPE_PRICE_SCHOOL_YEARLY=
STRIPE_PRICE_DISTRICT_YEARLY=
# Price ID for buying a kit's online access by card (one code per kit)
STRIPE_PRICE_KIT=

# ---------- Curie.AI (Phase 3) ----------
# Unset = local rule-based tutor stand-in (still filtered and rate-limited).
ANTHROPIC_API_KEY=
CURIE_MODEL=claude-opus-5-5
CURIE_DAILY_LIMIT_DEFAULT=200
CURIE_RETENTION_DAYS=30
